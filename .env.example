BOT_TOKEN=
DATABASE_URL=postgresql://postgres@localhost:5432/syrlasy
BOT_MODE=polling
# Set true on Render after migrating the old database and stopping the old bot:
AUTO_REGISTER_WEBHOOK=false
# Optional on Render (RENDER_EXTERNAL_URL is supplied by the platform):
# WEBHOOK_BASE_URL=https://YOUR-SERVICE.onrender.com
# Required in webhook and register-webhook modes; independent random secret:
WEBHOOK_SECRET=
# Optional; the original admin chat remains the default:
ADMIN_CHAT_ID=-5571000368
